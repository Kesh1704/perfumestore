/* Basic Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  line-height: 1.5;
  background-color: #fafafa;
  color: #333;
}

header {
  background-color: #f49ac1;
  color: white;
  padding: 1rem;
  text-align: center;
}

nav a {
  color: white;
  text-decoration: none;
  margin: 0 1rem;
}

main {
  padding: 1rem;
}

footer {
  text-align: center;
  padding: 1rem;
  background-color: #eee;
  margin-top: 2rem;
}

/* Product List */
#product-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rem;
}

.product {
  border: 1px solid #ddd;
  border-radius: 8px;
  width: 200px;
  padding: 1rem;
  background: white;
  text-align: center;
}

.product img {
  max-width: 100%;
  border-radius: 4px;
}

.product h3 {
  margin: 0.5rem 0;
}

.product p {
  margin: 0.5rem 0;
}

.product button {
  padding: 0.5rem 1rem;
  background-color: #f49ac1;
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}

.product button:hover {
  background-color: #d96ca9;
}

/* Cart */
#cart-container div {
  border-bottom: 1px dashed #ccc;
  padding: 0.5rem 0;
}

#cart-container h2 {
  margin-top: 1rem;
}

#cart-container button {
  padding: 0.5rem 1rem;
  background-color: #4CAF50;
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}

#cart-container button:hover {
  background-color: #45a049;
}
